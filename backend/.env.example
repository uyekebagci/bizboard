# =============================================================================
# BizBoard Backend — Environment variable reference
# =============================================================================
# Copy this file to .env for local development, OR set these values in the
# Sevalla dashboard ("App → Environment Variables") for production.
# NEVER commit a populated .env to version control.
# =============================================================================

# ── Spring profile ──────────────────────────────────────────────────────────
# local | prod
SPRING_PROFILES_ACTIVE=local

# ── Database (use Sevalla Managed PostgreSQL in production) ─────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bizboard
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# After the first successful prod deploy, lock the schema:
#   JPA_DDL_AUTO=validate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
VIRTUAL_THREADS_ENABLED=true

# ── Security ────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=bizboard-super-secret-key-that-is-at-least-256-bits-long-for-hs256
JWT_EXPIRATION_MS=604800000

# Comma-separated list of frontend origins permitted by CORS.
# Example:  https://app.example.com,https://test.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Storage (file uploads) ──────────────────────────────────────────────────
# local | s3
APP_STORAGE_TYPE=local

# Local-only:
APP_STORAGE_LOCAL_ROOT=./uploads

# S3-compatible (Sevalla Object Storage, Cloudflare R2, Backblaze B2, MinIO, AWS S3):
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=auto
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=
APP_STORAGE_S3_PATH_STYLE=true
# Prefix all objects (lets you share one bucket between prod & test): e.g. prod/  or  test/
APP_STORAGE_S3_PREFIX=

# Hard upload size limit (bytes). 10 MB by default. Must match (or be ≤)
# UPLOAD_MAX_FILE_SIZE on the servlet side.
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=15MB

# ── Audit / Integrations ────────────────────────────────────────────────────
AUDIT_LOG_FILE_DOWNLOADS=true

# Turn OFF in the test environment so emails / SMS / payment webhooks
# never reach real users while exercising prod-like data.
APP_EXTERNAL_INTEGRATIONS_ENABLED=true

# ── Observability ───────────────────────────────────────────────────────────
ACTUATOR_EXPOSE=health,info,metrics,prometheus
