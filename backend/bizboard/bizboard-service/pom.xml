            <groupId>com.bizboard</groupId>
            <artifactId>bizboard-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bizboard</groupId>
            <artifactId>bizboard-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bizboard</groupId>
