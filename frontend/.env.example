# =============================================================================
# BizBoard Frontend (Next.js) — Environment variable reference
# =============================================================================
# Copy to .env.local for development, or set in Sevalla dashboard for prod.
# All NEXT_PUBLIC_* variables are baked into the client bundle at build time —
# do NOT put secrets here.
# =============================================================================

# Public URL of the backend API (used by client-side fetch).
# Local:        http://localhost:8080
# Production:   https://api.bizboard.example.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Environment label, surfaced in the UI banner ("test", "prod", "local").
NEXT_PUBLIC_ENV=local

# Optional version tag, shown in footer / Sentry.
NEXT_PUBLIC_APP_VERSION=dev

# Server-side fetch URL — only used inside Next.js Server Components / Route Handlers.
# When frontend and backend are on the same Sevalla project this can be the internal
# service hostname (e.g. https://bizboard-api.internal.sevalla.app) — falls back to
# NEXT_PUBLIC_API_URL when unset.
BACKEND_URL=
